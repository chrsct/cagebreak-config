.IP \(bu 4
output: output as a string
.IP \(bu 4
output_id: id of the output as an integer
.IP \(bu 4
vertical: 0 if horizontal split, 1 if not
.PD
.PP
.RE
.RE
.nf
.RS 4
hsplit
cg\-ipc{"event_name":"split",
"tile_id":11,
"new_tile_id":12,
"workspace":1,
"output":"eDP\-1",
"output_id":1,
"vertical":0}
.fi
.RE
.PP
\fBswap_tile\fR
.RS 4
.PD 0
.IP \(bu 4
Trigger: the \fBexchange\fR family of commands
.IP \(bu 4
JSON
.RS 4
.IP \(bu 4
event_name: "swap_tile"
.IP \(bu 4
tile_id: previous tile id as an integer
.IP \(bu 4
tile_pid: pid of previous tile
.IP \(bu 4
swap_tile_id: swap tile id as an integer
.IP \(bu 4
swap_tile_pid: pid of swap tile
.IP \(bu 4
workspace: workspace number as an integer
.IP \(bu 4
output: name of the output as a string
.IP \(bu 4
output_id: id of the output as an integer
.PD
.PP
.RE
.RE
.nf
.RS 4
exchangeright
cg\-ipc{"event_name":"swap_tile",
"tile_id":1,
"tile_pid":53478,
"swap_tile_id":3,
"swap_tile_pid":98234,
"workspace":1,
"output":"eDP\-1"}
.fi
.RE
.PP
\fBswitch_default_mode\fR
.RS 4
.PD 0
.IP \(bu 4
Trigger: \fBsetmode\fR command
.IP \(bu 4
JSON
.RS 4
.IP \(bu 4
event_name: "switch_default_mode"
.IP \(bu 4
old_mode: old mode name
.IP \(bu 4
mode: new mode name
.PD
.PP
.RE
.RE
.nf
.RS 4
setmode top
cg\-ipc{"event_name":"switch_default_mode","old_mode":"top","mode":"root"}
.fi
.RE
.PP
switch_output
.RS 4
.PD 0
.IP \(bu 4
Trigger.\& \fBscreen\fR command
.IP \(bu 4
JSON
.RS 4
.IP \(bu 4
event_name: "switch_output"
.IP \(bu 4
old_output: name of the old output as a string
.IP \(bu 4
old_output_id: old output id as an integer
.IP \(bu 4
new_output: name of the new output as a string
.IP \(bu 4
new_output_id: new output id as an integer
.PD
.PP
.RE
.RE
.nf
.RS 4
screen 2
cg\-ipc{"event_name":"switch_output",
"old_output":"eDP\-1",
"old_output_id":1,
"new_output":"HDMI\-A\-1",
"new_output_id":2}
.fi
.RE
.PP
switch_ws
.RS 4
.PD 0
.IP \(bu 4
Trigger: \fBworkspace\fR command
.IP \(bu 4
JSON
.RS 4
.IP \(bu 4
event_name: "switch_ws"
.IP \(bu 4
old_workspace: old workspace number as an integer
.IP \(bu 4
new_workspace: new workspace number as an integer
.IP \(bu 4
output: name of the output as a string
.IP \(bu 4
output_id: id of the output as an integer
.PD
.PP
.RE
.RE
.nf
.RS 4
workspace 2
cg\-ipc{"event_name":"switch_ws",
"old_workspace":1,
"new_workspace":2,
"output":"eDP\-1",
"output_id":1}
.fi
.RE
